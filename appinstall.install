#!/usr/bin/env bash
# pacman hooks for appinstall

readonly _MIMEAPPS="/etc/xdg/mimeapps.list"
readonly _DESKTOP="appinstall.desktop"
readonly -a _MIMES=(
  application/vnd.flatpak
  application/vnd.flatpak.ref
  application/vnd.flatpak.repo
  application/vnd.appimage
  application/x-iso9660-appimage
  application/x-quickdrop-appimage
)

default_handler() {
  [ -f "$_MIMEAPPS" ] || printf '[Default Applications]\n' > "$_MIMEAPPS"
  grep -q '^\[Default Applications\]' "$_MIMEAPPS" \
    || printf '[Default Applications]\n' >> "$_MIMEAPPS"
  local m
  for m in "${_MIMES[@]}"; do
    if grep -q "^${m}=" "$_MIMEAPPS"; then
      sed -i "s|^${m}=.*|${m}=${_DESKTOP}|" "$_MIMEAPPS"
    else
      sed -i "/^\[Default Applications\]/a ${m}=${_DESKTOP}" "$_MIMEAPPS"
    fi
  done
}

drop_handler() {
  local m
  for m in "${_MIMES[@]}"; do
    sed -i "\\|^${m}=${_DESKTOP}$|d" "$_MIMEAPPS"
  done
}

post_install() {
  default_handler
}

post_upgrade() {
  default_handler
}

pre_remove() {
  drop_handler
}
