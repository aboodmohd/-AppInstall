[Desktop Entry]
Type=Service
Name=AppInstall AppImage Review
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-quickdrop-appimage;
Actions=ReviewWithAppInstall;
X-KDE-Priority=TopLevel
X-KDE-RequiredNumberOfUrls=1
X-AppInstall-Managed=true

[Desktop Action ReviewWithAppInstall]
Name=Review with AppInstall…
Icon=appinstall
Exec=appinstall %f
