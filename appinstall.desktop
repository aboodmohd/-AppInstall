[Desktop Entry]
Type=Application
Name=AppInstall
GenericName=Application Installer
Comment=Install AppImage, Flatpak, DEB, and RPM applications
Exec=appinstall %F
NoDisplay=false
Terminal=false
StartupNotify=false
Icon=appinstall
Categories=Utility;
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/vnd.flatpak;application/vnd.flatpak.ref;application/vnd.flatpak.repo;application/vnd.appimage;application/x-iso9660-appimage;application/x-quickdrop-appimage;
