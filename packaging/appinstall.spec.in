# Internal AppInstall RPM packaging template. @VERSION@ / @RELEASE@ are
# populated by tools/build_rpm.sh from the canonical PKGBUILD.
# This RPM is intended for Fedora 44 testing; wider RPM distro support requires
# distro-specific dependency validation and separate approval.
Name:           abood-appinstall
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Install AppImage, Flatpak, DEB and RPM applications from the desktop
License:        MIT
URL:            https://github.com/aboodmohd/-AppInstall
Source0:        appinstall-%{version}.tar.gz
BuildArch:      noarch

Requires:       bash
Requires:       coreutils
Requires:       curl
Requires:       python3
Requires:       xdg-utils
Requires:       python3-pyside6
Requires:       qt6-qtdeclarative
Recommends:     desktop-file-utils
Recommends:     shared-mime-info
Suggests:       flatpak
Suggests:       podman
Suggests:       distrobox
Suggests:       squashfs-tools

%description
AppInstall reviews and installs AppImage, Flatpak, DEB and RPM files through
a Qt desktop interface. DEB/RPM application packages run through explicitly
confirmed rootless Distrobox containers, not directly on the host.

%prep
%setup -q -c

%build
# Pure Python, shell and QML; no compiled libraries are bundled.

%install
mkdir -p %{buildroot}
cp -a usr %{buildroot}/

%files
%{_bindir}/abood-appinstall
%{_prefix}/lib/abood-appinstall
%{_datadir}/applications/io.github.aboodmohd.AppInstall.desktop
%{_datadir}/kio/servicemenus/io.github.aboodmohd.AppInstall.AppImageReview.desktop
%{_datadir}/icons/hicolor/*/apps/io.github.aboodmohd.AppInstall.png
%{_datadir}/abood-appinstall
%{_datadir}/doc/abood-appinstall
%license %{_datadir}/licenses/abood-appinstall/LICENSE

%changelog
* Sun Nov 15 2026 AppInstall Maintainers <maintainers@localhost> - @VERSION@-@RELEASE@
- Fedora 44 native RPM integrated into AppInstall v1.6.0 across three package formats.
- Keep AppInstall records and MIME defaults unchanged during installation.
